generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
}

// Tipo de nombramiento congregacional. NONE = publicador sin nombramiento.
// Solo puede asignarse a hombres (regla estricta validada en backend).
enum AppointmentType {
  NONE
  ELDER // Anciano
  MINISTERIAL_SERVANT // Siervo ministerial
}

enum AssignmentSection {
  BIBLE_READING
  APPLY_YOURSELF
  // ─── Fase 3: resto de la reunión (aditivo) ───
  OPENING // Inicio: presidente, oración inicial, palabras de introducción.
  TREASURES // Tesoros de la Biblia: punto 1, perlas, lectura.
  LIVING_AS_CHRISTIANS // Nuestra Vida Cristiana (dinámica) + Estudio Bíblico de la Congregación.
  CONCLUSION // Cierre: palabras de conclusión, oración final.
}

enum AssignmentType {
  BIBLE_READING
  START_CONVERSATION
  MAKE_RETURN_VISIT
  BIBLE_STUDY
  EXPLAIN_BELIEFS
  MAKE_DISCIPLES
  TALK
  OTHER
  // ─── Fase 3: resto de la reunión (aditivo, no altera SMM) ───
  CHAIRMAN // Presidente de la reunión.
  OPENING_COMMENTS // Palabras de introducción.
  OPENING_PRAYER // Oración inicial.
  TREASURES_TALK // Tesoros de la Biblia, punto 1 (título variable).
  SPIRITUAL_GEMS // Busquemos perlas escondidas.
  CHRISTIAN_LIVING // Parte(s) de Nuestra Vida Cristiana.
  CONGREGATION_BIBLE_STUDY_CONDUCTOR // Conductor del Estudio Bíblico de la Congregación.
  CONGREGATION_BIBLE_STUDY_READER // Lector del Estudio Bíblico de la Congregación.
  CONCLUDING_COMMENTS // Palabras de conclusión.
  CLOSING_PRAYER // Oración final.
  SONG // Canción (informativa, no asignable).
}

enum Room {
  MAIN
  AUXILIARY
}

enum AssignmentStatus {
  PROPOSED
  DRAFT
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ReminderType {
  INITIAL_NOTICE
  SEVEN_DAYS_BEFORE
  THREE_DAYS_BEFORE
  ONE_DAY_BEFORE
  SAME_DAY
  CHANGE_NOTICE
  CANCELLATION_NOTICE
}

enum ReminderStatus {
  // ─── Reestructuración mensajería robusta (aditivo) ───
  // DRAFT: snapshot congelado generado pero pendiente de revisión/aprobación.
  //        El worker NO lo toma. Se aprueba (batch) → READY.
  DRAFT
  // READY: snapshot aprobado y listo para enviar. El worker lo toma igual que PENDING.
  READY
  // PAUSED: envío detenido a propósito (WhatsApp caído o pausa manual del batch).
  //         El worker NO lo toma hasta reanudar (→ READY/PENDING).
  PAUSED
  PENDING
  QUEUED
  SENDING
  SENT
  FAILED
  SKIPPED
  CANCELLED
  DEAD
  // Envío AMBIGUO (H1/H3): el resultado del envío no pudo confirmarse (timeout de
  // red, excepción de whatsapp-web.js tras encolar, etc.). NO se reintenta de forma
  // automática para no duplicar; requiere reconciliación (reaper) o decisión humana.
  UNCERTAIN
}

enum MessageLogStatus {
  SENT
  FAILED
  SKIPPED
}

enum WhatsappSessionStatus {
  STARTING
  QR_REQUIRED
  AUTHENTICATED
  READY
  DISCONNECTED
  FAILED
}

enum MonthlyScheduleStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum MeetingWeekStatus {
  DRAFT
  READY
  ACTIVE
  COMPLETED
  ARCHIVED
  CANCELLED
}

// Estado de la importación del programa real de WOL para una semana.
enum WeekImportStatus {
  EMPTY // Semana creada, aún sin programa importado.
  IMPORTING // Importación en curso.
  READY // Programa importado correctamente; se puede generar participantes.
  NEEDS_REVIEW // Se importó algo pero faltan datos o el parser no está seguro.
  IMPORT_FAILED // No se pudo importar desde WOL.
}

// Tipo de notificación para deduplicar el primer aviso por asignación/persona.
enum NotificationType {
  FIRST_ASSIGNMENT
  REMINDER
}

enum AutomationPlanStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  CANCELLED
  ARCHIVED
}

enum ReminderRecipientRole {
  ASSIGNED
  COMPANION
}

// ─── Models ──────────────────────────────────────────────

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JwPublisher {
  id                    String    @id @default(cuid())
  fullName              String
  displayName           String?
  phone                 String
  whatsappPhone         String?
  gender                Gender?
  isActive              Boolean   @default(true)
  canReceiveAssignments Boolean   @default(true)
  canBeCompanion        Boolean   @default(true)
  // ─── Estado congregacional ───
  isBaptized            Boolean         @default(true) // Publicador bautizado.
  isRegularPioneer      Boolean         @default(false) // Precursor(a) regular. Hombre o mujer.
  appointment           AppointmentType @default(NONE) // Nombramiento (solo hombres).
  // ─── Capacidades editables ───
  // Asignaciones básicas (canReceiveAssignments / canBeCompanion arriba).
  canParticipateSMM     Boolean   @default(true) // Seamos Mejores Maestros.
  canBibleReading       Boolean   @default(false) // Lectura de la Biblia (solo hombres).
  canGiveTalk           Boolean   @default(false) // Discurso (solo hombres).
  // Partes de la reunión.
  canBeChairman         Boolean   @default(false) // Presidente (solo hombres).
  canPray               Boolean   @default(false) // Oración (solo hombres).
  canTreasures          Boolean   @default(false) // Tesoros de la Biblia (solo hombres).
  canSpiritualGems      Boolean   @default(false) // Perlas Escondidas.
  canChristianLife      Boolean   @default(false) // Nuestra Vida Cristiana (solo hombres).
  canConductCBS         Boolean   @default(false) // Conducir Estudio Bíblico de la Congregación (solo hombres).
  canReadCBS            Boolean   @default(false) // Lector del Estudio Bíblico de la Congregación (solo hombres).
  canConcludingRemarks  Boolean   @default(false) // Palabras de conclusión.
  notes                 String?
  deletedAt             DateTime?
  // Future fields
  congregationId        String?
  email                 String?
  birthDate             DateTime?
  emergencyContact      String?
  roleNotes             String?
  tags                  String?
  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  assignedAssignments  JwAssignment[]         @relation("AssignedPublisher")
  companionAssignments JwAssignment[]         @relation("CompanionPublisher")
  reminders            JwAssignmentReminder[]
  reminderDeliveries   ReminderDelivery[]
  messageLogs          JwMessageLog[]
  notificationLogs     NotificationLog[]
}

model MonthlySchedule {
  id          String                @id @default(cuid())
  year        Int
  month       Int
  name        String
  status      MonthlyScheduleStatus @default(DRAFT)
  archivedAt  DateTime?
  cancelledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  weeks JwMeetingWeek[]

  @@unique([year, month])
}

model JwMeetingWeek {
  id                 String            @id @default(cuid())
  monthlyScheduleId  String?
  weekStartDate      DateTime
  weekStartDateLocal String?
  meetingDate        DateTime
  meetingDateLocal   String?
  meetingTime        String
  congregationName   String?
  notes              String?
  status             MeetingWeekStatus @default(DRAFT)
  archivedAt         DateTime?
  cancelledAt        DateTime?
  completedAt        DateTime?
  // ─── Integración con WOL (Vida y Ministerio) ───
  isoYear            Int? // Año ISO que corresponde a la semana (para la URL de WOL).
  isoWeekNumber      Int? // Número de semana ISO (1..53).
  wolMeetingsUrl     String? // https://wol.jw.org/es/wol/meetings/r4/lp-s/{year}/{week}
  wolProgramUrl      String? // Enlace real del programa de esa semana (/wol/d/...).
  importStatus       WeekImportStatus  @default(EMPTY)
  importedAt         DateTime?
  importError        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  monthlySchedule MonthlySchedule? @relation(fields: [monthlyScheduleId], references: [id])
  assignments     JwAssignment[]
  assignmentTemplates AssignmentTemplate[]
  programItems    MeetingProgramItem[]

  @@index([monthlyScheduleId])
  @@index([status])
  @@index([importStatus])
}

model JwAssignment {
  id                     String            @id @default(cuid())
  meetingWeekId          String
  assignmentNumber       Int
  section                AssignmentSection
  assignmentType         AssignmentType
  title                  String
  durationMinutes        Int?
  context                String?
  reference              String?
  assignedPublisherId    String
  companionPublisherId   String?
  assignedNameSnapshot   String?
  assignedPhoneSnapshot  String?
  companionNameSnapshot  String?
  companionPhoneSnapshot String?
  room                   Room
  notes                  String?
  status                 AssignmentStatus  @default(DRAFT)
  version                Int               @default(1)
  programItemId          String? // Item real de WOL sobre el que se asigna (si aplica).
  // Inicio de reunión: true cuando la oración inicial / palabras de introducción
  // se autocompletaron con el presidente y NO se han editado manualmente. Si el
  // administrador cambia la persona a mano, pasa a false y deja de sincronizarse
  // automáticamente al cambiar el presidente.
  autoFilledFromChairman Boolean           @default(false)
  completedAt            DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  meetingWeek        JwMeetingWeek          @relation(fields: [meetingWeekId], references: [id])
  assigned           JwPublisher            @relation("AssignedPublisher", fields: [assignedPublisherId], references: [id])
  companion          JwPublisher?           @relation("CompanionPublisher", fields: [companionPublisherId], references: [id])
  programItem        MeetingProgramItem?    @relation(fields: [programItemId], references: [id])
  reminders          JwAssignmentReminder[]
  automationPlans    AutomationPlan[]
  reminderDeliveries ReminderDelivery[]
  messageLogs        JwMessageLog[]
  notificationLogs   NotificationLog[]

  @@index([meetingWeekId, status])
  @@index([assignedPublisherId])
  @@index([companionPublisherId])
  @@index([programItemId])
}

model AssignmentTemplate {
  id               String            @id @default(cuid())
  meetingWeekId    String
  order            Int
  assignmentNumber Int
  section          AssignmentSection
  assignmentType   AssignmentType
  title            String
  durationMinutes  Int?
  needsCompanion   Boolean           @default(false)
  room             Room              @default(MAIN)
  reference        String?
  source           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  meetingWeek JwMeetingWeek @relation(fields: [meetingWeekId], references: [id])

  @@unique([meetingWeekId, assignmentNumber])
  @@index([meetingWeekId])
}

model AutomationPlan {
  id               String               @id @default(cuid())
  assignmentId     String
  status           AutomationPlanStatus @default(DRAFT)
  version          Int                  @default(1)
  timezone         String
  sendHour         Int
  meetingDateLocal String
  meetingTimeLocal String
  rules            Json
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  cancelledAt      DateTime?
  supersededAt     DateTime?
  archivedAt       DateTime?

  assignment         JwAssignment       @relation(fields: [assignmentId], references: [id])
  reminderDeliveries ReminderDelivery[]
  messageLogs        JwMessageLog[]

  @@unique([assignmentId, version])
  @@index([assignmentId, status])
}

model ReminderDelivery {
  id               String                @id @default(cuid())
  automationPlanId String
  assignmentId     String
  publisherId      String
  recipientRole    ReminderRecipientRole
  reminderType     ReminderType
  scheduledAt      DateTime
  sentAt           DateTime?
  status           ReminderStatus        @default(PENDING)
  customMessage    String?
  attemptCount     Int                   @default(0)
  maxAttempts      Int                   @default(3)
  nextRetryAt      DateTime?
  lastAttemptAt    DateTime?
  deadAt           DateTime?
  errorMessage     String?
  // H1 (idempotencia): clave estable del último intento de envío (por
  // entrega/grupo + teléfono + contenido). El servicio WhatsApp deduplica por
  // esta clave; el reaper la usa para reconciliar filas SENDING atoradas.
  idempotencyKey   String?
  // H3: instante en el que la entrega pasó a UNCERTAIN (envío ambiguo).
  uncertainAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  // ─── Snapshot congelado (reestructuración mensajería robusta) ───
  // El texto FINAL que se enviará, congelado al generar/aprobar. El worker envía
  // ESTO tal cual y NO vuelve a renderizar. Si es null (legacy/transición), el
  // worker cae al render en vivo por compatibilidad.
  renderedMessage   String?
  renderedVariables Json? // variables usadas para renderizar (auditoría).
  templateId        String? // plantilla usada.
  templateVersionId String? // versión concreta de la plantilla.
  manuallyEdited    Boolean   @default(false) // true si se editó el texto final a mano.
  editedAt          DateTime?
  regeneratedAt     DateTime?
  // TEMPLATE | MANUAL_EDIT | REGENERATED_TEMPLATE | REGENERATED_VERSION | LEGACY_RENDER.
  sourceType        String?
  batchId           String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  automationPlan AutomationPlan @relation(fields: [automationPlanId], references: [id])
  assignment     JwAssignment   @relation(fields: [assignmentId], references: [id])
  publisher      JwPublisher    @relation(fields: [publisherId], references: [id])
  messageLogs    JwMessageLog[]
  batch          MessageBatch?  @relation(fields: [batchId], references: [id])

  @@unique([automationPlanId, publisherId, reminderType])
  @@index([status, scheduledAt])
  @@index([assignmentId, status])
  @@index([publisherId, status])
  @@index([automationPlanId, status])
  @@index([batchId])
}

model JwAssignmentReminder {
  id               String                 @id @default(cuid())
  automationPlanId String?
  recipientRole    ReminderRecipientRole?
  assignmentId     String
  publisherId      String
  reminderDay      ReminderType
  scheduledAt      DateTime
  sentAt           DateTime?
  status           ReminderStatus         @default(PENDING)
  errorMessage     String?
  cancelledAt      DateTime?
  cancelReason     String?
  generationKey    String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  assignment JwAssignment @relation(fields: [assignmentId], references: [id])
  publisher  JwPublisher  @relation(fields: [publisherId], references: [id])

  @@unique([assignmentId, publisherId, reminderDay])
  @@index([automationPlanId, status])
  @@index([status, scheduledAt])
}

model JwMessageTemplate {
  id        String   @id @default(cuid())
  type      String   @unique
  title     String
  body      String
  isActive  Boolean  @default(true)
  // ─── Reestructuración mensajería robusta (aditivo) ───
  // Descripción para el panel y número de versión activa. `body` sigue siendo el
  // cuerpo de la versión activa (espejo) para compatibilidad; el historial vive
  // en MessageTemplateVersion.
  description   String?
  activeVersion Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions MessageTemplateVersion[]
}

// Historial de versiones de una plantilla global. Cada edición desde el panel
// crea una nueva versión; NO se sobrescribe. El snapshot de un mensaje generado
// referencia la versión concreta con la que se renderizó, de modo que editar la
// plantilla luego NO cambia mensajes ya congelados.
model MessageTemplateVersion {
  id              String   @id @default(cuid())
  templateId      String
  version         Int
  body            String
  variablesSchema Json? // variables detectadas/documentadas al guardar.
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  createdBy       String? // usuario que editó, si el sistema lo maneja.

  template JwMessageTemplate @relation(fields: [templateId], references: [id])

  @@unique([templateId, version])
  @@index([templateId])
}

// Lote de generación de mensajes (revisión/aprobación/pausa). Agrupa las
// entregas congeladas de una generación (p. ej. aviso inicial del mes) para
// revisarlas juntas antes de enviar y para pausar/reanudar en bloque.
model MessageBatch {
  id                String    @id @default(cuid())
  type              String // ReminderType al que corresponde el lote.
  monthlyScheduleId String?
  meetingWeekId     String?
  periodLabel       String? // "Julio 2026", "Semana 6-12 jul", etc.
  // DRAFT | READY | APPROVED | PAUSED | SENDING | DONE | CANCELLED (string libre).
  status            String    @default("DRAFT")
  createdBy         String?
  approvedAt        DateTime?
  pausedAt          DateTime?
  pauseReason       String?
  resumedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  deliveries ReminderDelivery[]

  @@index([status])
  @@index([monthlyScheduleId])
  @@index([meetingWeekId])
}

model JwMessageLog {
  id                 String           @id @default(cuid())
  assignmentId       String?
  publisherId        String?
  automationPlanId   String?
  reminderDeliveryId String?
  phone              String
  messageType        String?
  messageBody        String
  providerMessageId  String?
  status             MessageLogStatus
  errorMessage       String?
  sentAt             DateTime?
  createdAt          DateTime         @default(now())

  assignment       JwAssignment?     @relation(fields: [assignmentId], references: [id])
  publisher        JwPublisher?      @relation(fields: [publisherId], references: [id])
  automationPlan   AutomationPlan?   @relation(fields: [automationPlanId], references: [id])
  reminderDelivery ReminderDelivery? @relation(fields: [reminderDeliveryId], references: [id])

  @@index([automationPlanId])
  @@index([reminderDeliveryId])
}

model JwAutomationEvent {
  id         String   @id @default(cuid())
  eventType  String
  entityType String
  entityId   String
  actorType  String?
  actorId    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([eventType])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model JwWhatsappSessionLog {
  id        String                @id @default(cuid())
  status    WhatsappSessionStatus
  message   String?
  createdAt DateTime              @default(now())
}

// H1 — Idempotencia de envío. El servicio WhatsApp registra AQUÍ cada intento
// físico de envío, indexado por una clave idempotente estable. Si llega una
// solicitud con una clave ya SENT, NO se reenvía: se devuelve el messageId
// previo. Sobrevive a reinicios del proceso (crash-safe) porque vive en la DB
// compartida. También sirve para reconciliar entregas SENDING atoradas (reaper).
model WhatsappOutbox {
  id                String    @id @default(cuid())
  idempotencyKey    String    @unique
  phone             String
  contentHash       String
  // SENDING | SENT | FAILED | UNCERTAIN | REJECTED (string libre para no acoplar enums).
  status            String
  providerMessageId String?
  error             String?
  attempts          Int       @default(0)
  // ACK real de WhatsApp: -1=error, 0=pending, 1=server, 2=delivered, 3=read, 4=played
  ack               Int?
  ackUpdatedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sentAt            DateTime?

  // Guarda secundaria anti-duplicado: mismo teléfono + mismo contenido reciente.
  @@index([phone, contentHash, status])
  // Reaper / reconciliación por antigüedad.
  @@index([status, updatedAt])
  // Lookup por messageId para actualizar ACK.
  @@index([providerMessageId])
}

model AppConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// Programa real de una semana importado desde WOL (Vida y Ministerio).
// Es la fuente sobre la que se asignan personas; nunca se inventa.
model MeetingProgramItem {
  id              String   @id @default(cuid())
  meetingWeekId   String
  itemNumber      Int? // Número de la parte en WOL (4, 5, 6...). Null en Lectura de la Biblia.
  section         String? // Sección general, p. ej. "Seamos mejores maestros".
  title           String // "Lectura de la Biblia", "Empiece conversaciones"...
  assignmentType  AssignmentType @default(OTHER)
  durationMinutes Int?
  context         String? // "PREDICACIÓN INFORMAL", "DE CASA EN CASA".
  description     String? // Instrucción completa.
  reference       String? // "lmd lección 1 punto 4".
  lesson          String? // "th lección 2".
  requiresAssistant Boolean @default(false)
  // Fase 3: distingue partes asignables de las informativas (p. ej. canciones).
  // false = se muestra en el programa pero NO genera slot/asignación/recordatorio.
  requiresAssignee Boolean @default(true)
  sourceUrl       String? // URL de WOL de origen.
  sortOrder       Int      @default(0)
  rawText         String? // Texto original extraído (auditoría).
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  meetingWeek JwMeetingWeek  @relation(fields: [meetingWeekId], references: [id])
  assignments JwAssignment[]

  // Upsert estable por semana + posición (sortOrder). itemNumber puede ser null
  // (p. ej. Lectura de la Biblia) y los títulos podrían repetirse, por lo que la
  // posición dentro de la semana es el identificador confiable.
  @@unique([meetingWeekId, sortOrder])
  @@index([meetingWeekId])
}

// Registro de notificaciones para evitar duplicados (primer aviso) y auditar envíos.
model NotificationLog {
  id                String           @id @default(cuid())
  assignmentId      String
  recipientPersonId String
  notificationType  NotificationType
  // Clave fina de deduplicación. FIRST_ASSIGNMENT se envía una sola vez, pero los
  // recordatorios se distinguen por clave (REMINDER_7_DAYS, REMINDER_3_DAYS,
  // REMINDER_1_DAY, REMINDER_SAME_DAY...) para permitir varios sin duplicar.
  notificationKey   String
  status            MessageLogStatus
  sentAt            DateTime?
  whatsappMessageId String?
  errorMessage      String?
  createdAt         DateTime         @default(now())

  assignment JwAssignment @relation(fields: [assignmentId], references: [id])
  recipient  JwPublisher  @relation(fields: [recipientPersonId], references: [id])

  // No reenviar la misma notificación (misma clave) a la misma persona para la
  // misma asignación. Permite múltiples recordatorios con claves distintas.
  @@unique([assignmentId, recipientPersonId, notificationKey])
  @@index([assignmentId])
  @@index([recipientPersonId])
}
