 both 113px display and 15px body is unusual \u2014 it means the brand trusts scale, not weight, for hierarchy. \u00b7 `--font-ppneuemontreal`", "file_type": "document", "source_file": "DESIGN.md", "source_location": "L22"}, {"id": "c_users_amaury_documents_jw_reminders_design_type_scale", "label": "Type Scale", "file_type": "document", "source_file": "DESIGN.md", "source_location": "L31"}, {"id": "c_users_amaury_documents_jw_reminders_design_tokens_spacing_shapes", "label": "Tokens \u2014 Spacing & Shapes", "file_type": "document", "source_file": "DESIGN.md", "source_location": "L46"}, {"id": "c_users_amaury_documents_jw_reminders_design_spacing_scale", "label": "Spacing Scale", "file_type": "document", "source_file": "DESIGN.md", "source_location": "L52"}, {"id": "c_users_amaury_documents_jw_reminders_design_border_radius", "label": "Border Radius", "file_type": "document", "source_file": "DESIGN.md", "source_location": "L66"}, {"id": "c_users_amaury_documents_jw_reminders_design_layout", "label": "Layout", "file_type": "document", "source_file": "DESIGN.md", "source_location": "L75"}, {"id": "c_users_amaury_documents_jw_reminders_design_components", "label": "Components", "file_type": "document", "source_file": "DESIGN.md", "source_location": "L82"}, {"id": "c_users_amaury_documents_jw_reminders_design_primary_action_button", "label": "Primary Action Button", "file_type": "document", "source_file": "DESIGN.md", "source_location": "L84"}, {"id": "c_users_amaury_documents_jw_reminders_design_ghost_text_button", "label": "Ghost Text Button", "file_type": "document", "source_file": "DESIGN.md", "source_location": "L89"}, {"id": "c_users_amaury_documents_jw_reminders_design_logo_lockup", "label": "Logo Lockup", "file_type": "document", "source_file": "DESIGN.md", "source_location": "L94"}, {"id": "c_users_amaury_documents_jw_reminders_design_team_member_card", "label": "Team Member Card", "file_type": "document", "source_file": "DESIGN.md", "source_location": "L99"}, 