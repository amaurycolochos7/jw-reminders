# ─── Database ───────────────────────────────
POSTGRES_DB=jw_reminders
POSTGRES_USER=jw_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://jw_admin:CHANGE_ME@db:5432/jw_reminders

# ─── Auth ────────────────────────────────────
# Debe ser largo (>=16 chars) y aleatorio. En producción el API NO arranca sin él.
JWT_SECRET=CHANGE_ME_RANDOM_SECRET
# Contraseña del admin al sembrar (bcrypt). Si se omite, el seed genera una temporal.
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# Orígenes permitidos para CORS (coma-separados). Vacío en prod = ninguno.
CORS_ORIGINS=https://jw-reminders.duckdns.org

# ─── WhatsApp ────────────────────────────────
WHATSAPP_API_URL=http://whatsapp:3010
WHATSAPP_SESSION_PATH=/app/.wwebjs_auth
# Token compartido API/worker ↔ servicio WhatsApp (auth interna). Aleatorio.
WHATSAPP_INTERNAL_TOKEN=CHANGE_ME_INTERNAL_TOKEN

# ─── Test Mode ───────────────────────────────
TEST_MODE=true
TEST_PHONE=521XXXXXXXXXX

# ─── Worker ──────────────────────────────────
CRON_SCHEDULE=*/10 * * * *

# ─── Frontend ────────────────────────────────
NEXT_PUBLIC_API_URL=
INTERNAL_API_URL=http://jw-reminders-api:4000

# ─── Research Chat (Beta) ────────────────────
# Para activar: RESEARCH_CHAT_ENABLED=true + configurar OPENAI_API_KEY.
# La API key de OpenAI vive SOLO en backend, nunca se expone al frontend.
RESEARCH_CHAT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
RESEARCH_CHAT_WOL_ENABLED=true
