# === REQUIRED ===
# Apify API Token (get it from https://console.apify.com/account/integrations)
APIFY_API_TOKEN=your_apify_token_here

# === OPTIONAL ===
# OpenAI API Key (for AI-generated outreach emails)
OPENAI_API_KEY=your_openai_key_here

# Hunter.io API Key (for finding business emails)
HUNTER_API_KEY=your_hunter_key_here
